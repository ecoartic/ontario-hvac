---
import site from "../data/site.fa.json";

const iconMap = {
  instagram: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.25" fill="currentColor"/></svg>',
  facebook: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.6 1.7-1.6H16.7V4.8c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.2V11H7.7v3h2.6v8h3.2Z"/></svg>',
  google: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.8 12.2c0-.7-.1-1.3-.2-1.9H12v3.6h5.5c-.2 1.2-.9 2.3-2 3v2.4h3.2c1.9-1.8 3.1-4.4 3.1-7.1Z"/><path fill="currentColor" d="M12 22c2.8 0 5.2-.9 7-2.5l-3.2-2.4c-.9.6-2.1 1-3.8 1-2.9 0-5.3-1.9-6.1-4.5H2.6V16c1.8 3.6 5.5 6 9.4 6Z"/><path fill="currentColor" d="M5.9 13.6c-.2-.6-.4-1.2-.4-1.8s.1-1.3.4-1.8V7.6H2.6C1.9 9 1.5 10.5 1.5 12s.4 3 1.1 4.4l3.3-2.8Z"/><path fill="currentColor" d="M12 5.5c1.5 0 2.9.5 3.9 1.5l2.9-2.9C17.2 2.6 14.8 1.5 12 1.5c-3.9 0-7.6 2.4-9.4 6l3.3 2.5c.8-2.6 3.2-4.5 6.1-4.5Z"/></svg>',
  telegram: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.7 4.3 2.9 11.2c-1.2.5-1.2 1.2-.2 1.5l4.6 1.4 1.8 5.8c.2.6.1.9.8.9.5 0 .7-.2 1-.5l2.6-2.6 5.5 4.1c1 .5 1.8.3 2.1-.9l3-14.2c.4-1.5-.6-2.2-1.4-1.8Zm-11 9.4-.4 4.2-.2-3.5 8.1-7.3-7.5 6.6Z"/></svg>',
  youtube: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M23 12c0 3.4-.4 5.4-.9 6.5-.3.7-.8 1.2-1.5 1.5-1.1.5-3.1.9-8.6.9s-7.5-.4-8.6-.9c-.7-.3-1.2-.8-1.5-1.5C1.4 17.4 1 15.4 1 12s.4-5.4.9-6.5c.3-.7.8-1.2 1.5-1.5C4.5 3.5 6.5 3.1 12 3.1s7.5.4 8.6.9c.7.3 1.2.8 1.5 1.5.5 1.1.9 3.1.9 6.5Zm-13.5 3.8 6.2-3.8-6.2-3.8v7.6Z"/></svg>',
  linkedin: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 8.8H3.4V20h3.2V8.8ZM5 3.4a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM20.6 20v-6.1c0-3.3-1.8-4.8-4.2-4.8-1.9 0-2.8 1-3.2 1.7V8.8H10V20h3.2v-6.1c0-1.6.3-3.1 2.3-3.1 2 0 2.1 1.9 2.1 3.2V20h3Z"/></svg>',
  whatsapp: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20 4A10 10 0 0 0 4.4 16.1L3 21l5-1.3A10 10 0 1 0 20 4Zm-8 16a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20Zm4.5-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1l-.5.6c-.1.1-.3.2-.5.1-1-.5-1.9-1.2-2.6-2.1-.1-.2 0-.3.1-.5l.4-.5c.1-.2.1-.4 0-.6l-.7-1.7c-.1-.3-.3-.3-.5-.3H9c-.2 0-.5.1-.7.3-.6.6-.9 1.3-.9 2 0 .2.1.5.2.7.7 1.6 2.3 3.8 5.5 5.1.5.2 1 .4 1.5.4.7 0 1.7-.3 2-.9.2-.3.3-.8.3-.9 0-.1-.1-.2-.3-.3Z"/></svg>',
  email: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm0 2v.5l9 5.6 9-5.6V7H3Zm18 10V9.8l-8.5 5.3a1 1 0 0 1-1 0L3 9.8V17h18Z"/></svg>',
  location: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 22s7-6 7-12a7 7 0 1 0-14 0c0 6 7 12 7 12Zm0-9.5A2.5 2.5 0 1 1 12 7a2.5 2.5 0 0 1 0 5.5Z"/></svg>',
  phone: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V21c0 .6-.4 1-1 1C10.6 22 2 13.4 2 3c0-.6.4-1 1-1h4.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1l-2.2 2.2Z"/></svg>',
  globe: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 9h-3.1a15.8 15.8 0 0 0-1.3-5A8 8 0 0 1 18.9 11ZM12 4.1c.8 1 1.8 3 2.2 6H9.8c.4-3 1.4-5 2.2-6ZM9.5 6a15.8 15.8 0 0 0-1.3 5H5.1A8 8 0 0 1 9.5 6ZM5.1 13h3.1a15.8 15.8 0 0 0 1.3 5A8 8 0 0 1 5.1 13Zm6.9 6c-.8-1-1.8-3-2.2-6h4.4c-.4 3-1.4 5-2.2 6Zm2.5-1a15.8 15.8 0 0 0 1.3-5h3.1a8 8 0 0 1-4.4 5Z"/></svg>',
};

const fallbackSocialLinks = [
  { label: 'Instagram', href: site.instagramUrl, icon: 'instagram', enabled: site.instagramUrl && site.instagramUrl !== '#' },
  { label: 'Facebook', href: site.facebookUrl, icon: 'facebook', enabled: site.facebookUrl && site.facebookUrl !== '#' },
  { label: 'Google Business', href: site.googleBusinessUrl, icon: 'google', enabled: site.googleBusinessUrl && site.googleBusinessUrl !== '#' },
  { label: 'Telegram', href: site.telegramUrl, icon: 'telegram', enabled: site.telegramUrl && site.telegramUrl !== '#' },
  { label: 'YouTube', href: site.youtubeUrl, icon: 'youtube', enabled: site.youtubeUrl && site.youtubeUrl !== '#' },
  { label: 'LinkedIn', href: site.linkedinUrl, icon: 'linkedin', enabled: site.linkedinUrl && site.linkedinUrl !== '#' },
];

const socialLinks = (Array.isArray(site.socialLinks) ? site.socialLinks.map((item) => ({
  label: item.label,
  href: item.url,
  icon: item.icon || 'globe',
  enabled: item.enabled !== false && item.url && item.url !== '#',
})) : fallbackSocialLinks).filter((item) => item.enabled);

const primaryContacts = [
  { label: site.phoneDisplay, href: `tel:${site.phone}`, icon: 'phone' },
  { label: site.email, href: `mailto:${site.email}`, icon: 'email' },
  { label: site.address, href: site.googleMapsUrl, icon: 'location', target: '_blank' },
  { label: 'WhatsApp', href: `https://wa.me/${site.whatsapp}`, icon: 'whatsapp', target: '_blank' },
];
---
<footer class="site-footer">
  <div class="container footer-live">
    <div class="footer-brand">
      <img src={site.logoImage} alt={site.businessName} />
      <p>خدمات گرمایش، سرمایش و تجهیزات مرتبط در Ontario.</p>
      <div class="footer-chip-list">
        {primaryContacts.map((item) => (
          <a class="footer-chip" href={item.href} target={item.target} rel="noreferrer">
            <span class="footer-icon" set:html={iconMap[item.icon]} />
            <span>{item.label}</span>
          </a>
        ))}
      </div>
    </div>
    <div>
      <strong>دسترسی سریع</strong>
      <a href="/fa/">خانه</a>
      <a href="/fa/#services">خدمات</a>
      <a href="/fa/blog/">راهنما</a>
    </div>
    <div>
      <strong>راه‌های ارتباطی</strong>
      {primaryContacts.map((item) => (
        <a class="footer-link-with-icon" href={item.href} target={item.target} rel="noreferrer">
          <span class="footer-icon small" set:html={iconMap[item.icon]} />
          <span>{item.label}</span>
        </a>
      ))}
    </div>
    <div>
      <strong>شبکه‌های اجتماعی</strong>
      {socialLinks.length > 0 ? socialLinks.map((item) => (
        <a class="footer-link-with-icon" href={item.href} target="_blank" rel="noreferrer">
          <span class="footer-icon small" set:html={iconMap[item.icon] || iconMap.globe} />
          <span>{item.label}</span>
        </a>
      )) : <span>هنوز ثبت نشده</span>}
    </div>
  </div>
  <div class="container footer-reference"><img src={site.footerImage} alt="مرجع گرافیکی فوتر Ontario HVAC" /></div>
</footer>
