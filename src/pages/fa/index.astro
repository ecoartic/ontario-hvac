---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Footer from "../../components/Footer.astro";
import ContactButtons from "../../components/ContactButtons.astro";
import site from "../../data/site.fa.json";
import { withBase } from "../../utils/paths";
const serviceModules = import.meta.glob("../../content/services/fa/*.md", { eager: true });
const services = Object.values(serviceModules).map((m:any)=>m.frontmatter).filter((s:any)=>s.published !== false).sort((a:any,b:any)=>(a.order||99)-(b.order||99));
const blogModules = import.meta.glob("../../content/blog/fa/*.md", { eager: true });
const posts = Object.values(blogModules).map((m:any)=>m.frontmatter).filter((p:any)=>p.published !== false).sort((a:any,b:any)=>String(b.date).localeCompare(String(a.date))).slice(0,3);
---
<BaseLayout title={site.homeSeoTitle} description={site.homeSeoDescription} image={site.heroImage}>
  <SiteHeader />
  <main>
    <section class="hero-home">
      <div class="container hero-frame"><img src={withBase(site.heroImage)} alt={site.heroAlt} loading="eager" /></div>
      <div class="container hero-mobile-cta"><ContactButtons /></div>
    </section>

    <section id="services" class="section">
      <div class="container">
        <div class="section-head"><span>خدمات</span><h1>خدمات اصلی Ontario HVAC</h1><p>نسخه اولیه ساده است: معرفی خدمت، تماس مستقیم و صفحه اختصاصی برای هر سرویس.</p></div>
        <div class="services-grid">
          {services.map((service:any)=>(
            <a class="service-card" href={withBase(`/fa/services/${service.slug}/`)}>
              <img src={withBase(service.image)} alt={service.title} loading="lazy" />
              <h2>{service.title}</h2><small>{service.englishTitle}</small><p>{service.summary}</p><b>مشاهده خدمت ←</b>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="quick-contact section">
      <div class="container contact-grid"><div><span>دسترسی سریع</span><h2>برای هماهنگی مستقیم تماس بگیرید</h2><p>فعلاً فرم و CRM نداریم. مسیر تماس، واتساپ و لوکیشن برای تست واقعی سایت کافی است.</p><div class="contact-points"><a class="contact-point" href={`tel:${site.phone}`}><span class="footer-icon small">☎</span><span>{site.phoneDisplay}</span></a><a class="contact-point" href={`mailto:${site.email}`}><span class="footer-icon small">✉</span><span>{site.email}</span></a><a class="contact-point" href={site.googleMapsUrl} target="_blank" rel="noreferrer"><span class="footer-icon small">⌖</span><span>{site.address}</span></a></div></div><ContactButtons /></div>
    </section>

    {posts.length > 0 && <section class="section blog-preview"><div class="container"><div class="section-head"><span>راهنما</span><h2>مطالب و نکات</h2></div><div class="blog-grid">{posts.map((post:any)=><a class="blog-card" href={withBase(`/fa/blog/${post.slug}/`)}><img src={withBase(post.image)} alt={post.title} /><div><small>{post.date}</small><h3>{post.title}</h3><p>{post.summary}</p></div></a>)}</div><a class="text-link" href={withBase('/fa/blog/')}>مشاهده همه مطالب ←</a></div></section>}
  </main>
  <Footer />
</BaseLayout>
